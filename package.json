{
  "name": "sigapasap-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "sh -c 'for p in $(pgrep -f \"src/index[.]ts\" 2>/dev/null); do [ \"$p\" != \"$$\" ] && kill -9 \"$p\" 2>/dev/null; done; sleep 1; exec bun run src/index.ts'",
    "dev": "bun --watch src/index.ts",
    "seed": "bun run src/scripts/seed.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node-cron": "^3.0.11"
  }
}